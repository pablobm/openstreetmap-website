<% content_for :heading_class, "pb-0" %>

<% content_for :heading do %>
  <h1><%= t ".title" %></h1>
  <%= render :partial => "navigation" %>
<% end %>

<%= bootstrap_form_for @notification_preferences, :url => { :action => :update } do |f| %>
  <% @notification_preferences.event_preferences.each do |event_pref| %>
    <%= f.form_group event_pref.event_name, :label => {:text => "[form_group :label #{event_pref.event_name}]" } do %>
      <% event_pref.mechanisms.each do |mechanism| %>
        <%= check_box_tag "#{event_pref.event_name}[]", mechanism.name, mechanism.enabled?, :class => "notification_preference", :id => "#{event_pref.event_name}_#{mechanism.name}" %>
        <%= label_tag "#{event_pref.event_name}_#{mechanism.name}", t(".delivery_mechanisms.#{mechanism.name}"), :class => "form-label" %>
      <% end %>
    <% end %>
  <% end %>

  <%= f.primary t(".save") %>
<% end %>
