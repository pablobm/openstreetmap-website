<% content_for :head do %>
  <%= javascript_include_tag "notifications" %>
<% end %>

<% content_for :heading do %>
  <h1><%= t ".title" %></h1>
  <p class="mb-0">
    <%= t(
          ".point_to_preferences_html",
          :link => link_to(t(".link_text"), notification_preferences_path)
        ) %>
  </p>
<% end %>

<p><%= link_to "DEBUG: mark all notifications unread", notifications_path(:mark_all_unread => true), :class => "text-danger" %></p>

<% if @notifications.items.empty? %>
  <p><%= t(".no_notifications") %></p>
<% else %>
  <%= form_with :url => notifications_status_path, :method => :patch do |form| %>
    <div class="row">
      <label class="col-1 text-center">
        <%= check_box_tag "select_page", :class => "align-middle" %>
      </label>
      <div class="col-11"><%= form.submit t(".discard_selected"), :class => "submit-read" %></div>
    </div>
    <hr>
    <%= render "page", :notifications => @notifications, :params => @params, :form => form %>
  <% end %>
<% end %>
