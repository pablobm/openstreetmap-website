<%# locals: (notification:, record:) %>

<%= render(
      "notification_header",
      :title => t(".headline"),
      :uri => note_path(
        record.note,
        :anchor => "c#{record.id}"
      ),
      :timestamp => record.created_at
    ) %>

<%= render(
      "notification_body",
      :author => record.author
    ) do %>
    <p>
    <%= t(
          "notifications.note_comment.description_html",
          :commenter_name_with_link => link_to(
            record.author.display_name,
            record.author
          ),
          :note_id_with_link => link_to("##{record.note_id}", record.note),
          :note_text => record.note.description
        ) %>
    </p>
  <%= render "notification_quote", :body => record.body.to_html %>
<% end %>
