<%# locals: (notifications:, params:, form:) %>

<turbo-frame id="pagination" target="_top" data-turbo="false">
  <% notifications.items.each do |notification| %>
    <div class="row">
      <label class="col-1 text-center">
        <%= check_box_tag "notifications[#{notification.id}]", "read", :class => "notification-mark-read" %>
      </label>
      <div class="col-11">
        <%= render "notification", :notification => notification %>
      </div>
    </div>
    <hr>
  <% end %>

  <%= render "shared/pagination", :paginator => notifications, :params => params %>
</turbo-frame>
