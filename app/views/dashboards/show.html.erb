<% content_for :heading do %>
  <h1><%= t ".title" %></h1>
<% end %>
<%= render :partial => "layouts/markers", :locals => { :types => %w[dot] } %>

<div class="row">
  <div class="col">
    <div class="d-flex flex-row">
      <h2>Notifications</h2>
      <% if @notifications.any? %>
        <%= form_with :url => clear_notifications_path, :method => :delete do |form| %>
          <%= form.submit "Clear notifications" %>
        <% end %>
      <% end %>
    </div>
    <% if @notifications.any? %>
      <ul class="notification-list">
        <% @notifications.each do |notification| %>
          <li class="notification-list__entry">
            <% case notification.type %>
            <% when "NoteCommentNotifier::Notification" %>
                Comment in note <%= link_to "##{notification.event.record_id}", notification.event.record.note %>
                <% if notification.unseen? %><span class="notification-list__new">(new)</span><% end %>
            <% when "ChangesetCommentNotifier::Notification" %>
                Comment in changeset <%= link_to "##{notification.event.record_id}", notification.event.record.changeset %>
                <% if notification.unseen? %><span class="notification-list__new">(new)</span><% end %>
            <% when "GpxImportFailureNotifier::Notification" %>
              Failed importing GPX file <code><%= notification.event.params[:trace_name] %></code>, with title "<%= notification.event.params[:trace_description] %>"
                <% if notification.unseen? %><span class="notification-list__new">(new)</span><% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="no-notifications">No notifications</p>
    <% end %>
  </div>

  <div class="row">
    <div class="col-md order-md-last">
      <% if !current_user.home_location? %>
        <div id="map" class="content_map border border-secondary-subtle">
          <p class="m-3"><%= t(".no_home_location_html", :edit_profile_link => link_to(t(".edit_your_profile"), profile_location_path)) %></p>
        </div>
      <% else %>
        <% content_for :head do %>
          <%= javascript_include_tag "dashboard" %>
        <% end %>
        <% user_data = {
             :lon => current_user.home_lon,
             :lat => current_user.home_lat,
             :color => "var(--marker-red)",
             :description => render(:partial => "popup", :object => current_user, :locals => { :type => "your location" })
           } %>
        <%= tag.div "", :id => "map", :class => "content_map border border-secondary-subtle rounded z-0", :data => { :user => user_data } %>
      <% end %>
    </div>

    <div class="col-md">
      <h2><%= t ".followings" %></h2>

      <% if @followings.empty? %>
        <%= t ".no followings" %>
      <% else %>
        <nav class="secondary-actions mb-3">
          <ul>
            <li><%= link_to t(".followed_changesets"), friend_changesets_path %></li>
            <li><%= link_to t(".followed_diaries"), friends_diary_entries_path %></li>
          </ul>
        </nav>
        <div>
          <%= render :partial => "contact", :collection => @followings, :locals => { :type => "following" } %>
        </div>
      <% end %>

      <hr>

      <h2><%= t ".nearby users" %></h2>

      <% if @nearby_users.empty? %>
        <%= t ".no nearby users" %>
      <% else %>
        <nav class="secondary-actions mb-3">
          <ul>
            <li><%= link_to t(".nearby_changesets"), nearby_changesets_path %></li>
            <li><%= link_to t(".nearby_diaries"), nearby_diary_entries_path %></li>
          </ul>
        </nav>
        <div id="nearbyusers">
          <%= render :partial => "contact", :collection => @nearby_users, :locals => { :type => "nearby mapper" } %>
        </div>
      <% end %>
  </div>
</div>
